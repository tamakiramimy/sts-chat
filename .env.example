# Required secrets: use long random values and do not commit .env.
ADMIN_SETUP_SECRET=replace-with-a-random-parent-admin-secret
JWT_SECRET=replace-with-a-minimum-32-byte-random-secret
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret

# LIVEKIT_URL must be the WSS/WS address reachable by your clients.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_INTERNAL_URL=http://livekit:7880
# Optional host port overrides for a local instance when another LiveKit stack
# already owns the default 7880/7881/50000-50100 ports.
LIVEKIT_HOST_PORT=7880
LIVEKIT_RTC_TCP_HOST_PORT=7881
LIVEKIT_RTC_UDP_HOST_PORT_RANGE=50000-50100
LLM_LOCAL_BASE_URL=http://llama:8080/v1
LLM_LOCAL_MODEL=Qwen2.5-3B-Instruct-Q4_K_M
LLM_LOCAL_TIMEOUT_SECONDS=12

# Optional OpenAI-compatible fallback. Leave empty to disable cloud fallback.
CLOUD_API_BASE_URL=
CLOUD_API_KEY=
CLOUD_API_MODEL=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,livekit,voice-agent,llama-cpu
PIP_INDEX_URL=https://pypi.org/simple

DEFAULT_WAKE_WORD=sts-chat
DEFAULT_VOICE_ZH=zh_CN-huayan-medium
DEFAULT_VOICE_EN=en_US-lessac-medium
GATEWAY_DATABASE_PATH=/app/data/gateway.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
